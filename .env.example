# Copy the names you need into .env (never commit .env). Put each value right after the "=" with no comment on the same line.

# n8n API key: n8n > Settings > n8n API
N8N_API=
N8N_BASE_URL=https://n8n.srv1300653.hstgr.cloud

# Optional. Copied into the workflow's Config node when you run tools/deploy_n8n.js
# HeyGen key: heygen.com > Settings > API
HEYGEN_API_KEY=
# Avatar and voice IDs: run  node tools/heygen_list.js English
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Apify token: apify.com > Settings > Integrations
APIFY_TOKEN=
# ID from the Google Drive folder URL (default is the My Drive root)
DRIVE_FOLDER_ID=

# Optional: store runs in your own Supabase project instead of a local file.
# 1) Run supabase/schema.sql in the Supabase SQL Editor. 2) Fill in the two values below.
# Project URL: Dashboard > Project Settings > API > Project URL (looks like https://xxxx.supabase.co)
SUPABASE_URL=
# Service-role key: same page, "service_role" secret. Keep it private; it bypasses row-level security.
SUPABASE_SERVICE_KEY=

# Accounts (active automatically once Supabase storage above is configured).
# Comma-separated emails that are approved as admins the first time they sign in. Put YOUR sign-up email here.
ADMIN_EMAILS=
# Optional: the public/publishable key. Not needed; the backend falls back to the secret key for sign-in calls.
SUPABASE_PUBLISHABLE_KEY=
# Set to false to turn the login requirement off (local single-user use).
AUTH_REQUIRED=true

# The private n8n webhook path (the part after /webhook/). Needed on Netlify, where the git-ignored
# workflow/.webhook-path file does not exist. Locally it is read from that file automatically.
# Find it with:  cat workflow/.webhook-path
N8N_WEBHOOK_PATH=

# Voiceover for the video renderer (video/render.mjs). ElevenLabs dashboard > API Keys.
ELEVENLABS_API_KEY=
# Optional: voice id from ElevenLabs > Voices (default is the stock voice "Rachel").
ELEVENLABS_VOICE_ID=

# Online video rendering (GitHub Actions). Fine-grained token for this repository with "Actions: Read and write".
# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens. Also add it on Netlify.
GH_DISPATCH_TOKEN=
# Optional (default: Aniyanetworks/AI-Creative-Engine)
GITHUB_REPO=

# Google Drive folders/copies (optional). Private webhook of the n8n workflow created by tools/deploy_drive_n8n.js:
# https://<your n8n>/webhook/<contents of workflow/.drive-webhook-path>. Needed on Netlify so removing a run can delete its Drive
# folder; locally the app reads workflow/.drive-webhook-path itself, and set-secrets.mjs builds the GitHub secret from it.
N8N_DRIVE_WEBHOOK_URL=

# Single-image rendering from the app (optional). Printed by tools/deploy_image_n8n.js; needed on Netlify only.
N8N_IMAGE_WEBHOOK_URL=
# OpenAI image model and default quality (low|medium|high) for the n8n workflows / the app's Generate image button.
IMAGE_MODEL=
IMAGE_QUALITY=

# Usage and cost report: list prices used for the estimates (all optional; shown on the Usage page)
PRICE_CLAUDE_INPUT_PER_MTOK=
PRICE_CLAUDE_OUTPUT_PER_MTOK=
PRICE_IMAGE_LOW=
PRICE_IMAGE_MEDIUM=
PRICE_IMAGE_HIGH=
ELEVENLABS_CREDITS_PER_VIDEO=
PRICE_ELEVENLABS_PER_1K_CREDITS=

# Picture links for the ad previews (optional; needed on Netlify only). Printed by tools/deploy_preview_n8n.js.
N8N_PREVIEW_WEBHOOK_URL=

# Generate more / Rewrite (optional; needed on Netlify only). Printed by tools/deploy_write_n8n.js.
N8N_WRITE_WEBHOOK_URL=
# AI models people can choose (comma separated ids, optionally id:Label) and the defaults. All optional.
CLAUDE_MODELS=
IMAGE_MODELS=
CLAUDE_MODEL=
PRICE_CLAUDE_BY_MODEL=
PRICE_IMAGE_MINI_MULTIPLIER=

# Posting to Meta from the app (see SETUP.md "Posting to Meta"). Each person connects their own Facebook account.
META_APP_ID=
META_APP_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (same value locally and on Netlify)
TOKEN_ENC_KEY=
# Only needed for local testing, e.g. http://localhost:5173/api/meta/callback (on Netlify the site address is used automatically)
META_REDIRECT_URI=
